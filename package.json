{
  "name": "mira-mde",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build-storybook": "storybook build",
    "check": "pnpm check:format && turbo run check",
    "check:all": "pnpm check && pnpm lint && pnpm test && pnpm build",
    "check:format": "prettier . --check",
    "check:svelte": "turbo run check:svelte",
    "check:types": "turbo run check:types",
    "dev": "turbo run dev --filter=@mira-mde/demo",
    "fmt": "prettier . --write",
    "lint": "eslint .",
    "storybook": "storybook dev -p 9009 --no-open",
    "storybook:check": "pnpm build-storybook && pnpm test:visual",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "tsx scripts/visual/visual-update.ts",
    "test:visual:report": "playwright show-report"
  },
  "dependencies": {
    "@mira-mde/codemirror": "workspace:*",
    "@mira-mde/default-ui": "workspace:*",
    "@mira-mde/extensions": "workspace:*",
    "@mira-mde/plugin-ai": "workspace:*",
    "@mira-mde/plugin-mermaid": "workspace:*",
    "@mira-mde/preview": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@lucide/svelte": "^0.525.0",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/mcp": "0.8.0",
    "@storybook/svelte-vite": "^10.5.2",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.10.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "publint": "^0.3.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.5.2",
    "storybook-addon-tag-badges": "^3.1.0",
    "storybook-addon-visual-delta": "file:../../ui/packages/storybook-addon-visual-delta",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.0"
  }
}
