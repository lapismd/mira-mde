{
  "name": "mira-mde",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check:all": "pnpm check:format && pnpm check:types && pnpm check:svelte && pnpm lint && pnpm test && pnpm build",
    "check:format": "prettier . --check",
    "check:svelte": "turbo run check:svelte",
    "check:types": "turbo run check:types",
    "dev": "turbo run dev --filter=@mira-mde/demo",
    "fmt": "prettier . --write",
    "lint": "eslint .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.10.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "publint": "^0.3.15",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.4",
    "tsup": "^8.5.1",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.0"
  }
}
