{
  "name": "mira-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build-storybook": "pnpm build && node -e \"require('node:fs').mkdirSync('.visual-delta/cache',{recursive:true})\" && NODE_OPTIONS=--max-old-space-size=4096 storybook build --stats-json .visual-delta/cache",
    "changeset": "changeset",
    "catalog:check": "node ./scripts/check-catalog.mjs && node --test ./scripts/check-catalog.spec.mjs",
    "check": "pnpm check:format && turbo run check",
    "check:all": "pnpm check && pnpm lint && pnpm test && pnpm build",
    "check:format": "prettier . --check",
    "check:svelte": "turbo run check:svelte",
    "check:types": "turbo run check:types",
    "dev": "pnpm storybook",
    "fmt": "prettier . --write",
    "lint": "eslint .",
    "packages:check": "node ./scripts/check-package-boundaries.mjs && node --test ./scripts/check-package-boundaries.spec.mjs && pnpm release:check && pnpm release:test",
    "packages:pack": "pnpm build && node ./scripts/check-package-tarballs.mjs",
    "release:check": "node ./scripts/check-release-config.mjs && node ./scripts/check-release-workflow.mjs && node ./scripts/sync-release-versions.mjs --check",
    "release:intent": "node ./scripts/check-release-intent.mjs",
    "release:notes": "node ./scripts/create-github-releases.mjs",
    "release:plan": "node ./scripts/release-plan.mjs",
    "release:prepare": "node ./scripts/prepare-release.mjs",
    "release:publish": "node ./scripts/publish-release.mjs",
    "release:test": "node --test ./scripts/check-release-intent.spec.mjs ./scripts/check-release-workflow.spec.mjs ./scripts/create-github-releases.spec.mjs ./scripts/publish-release.spec.mjs ./scripts/release-manifest.spec.mjs ./scripts/release-plan.spec.mjs ./scripts/sync-release-versions.spec.mjs ./scripts/verify-npm-provenance.spec.mjs",
    "release:verify": "node ./scripts/verify-release.mjs",
    "release:version": "changeset version && pnpm install --lockfile-only && node ./scripts/sync-release-versions.mjs --write && prettier packages/*/package.json packages/*/CHANGELOG.md packages/mira-editor/src/version.ts --write",
    "storybook": "WATCHPACK_POLLING=250 node scripts/storybook-run.mjs --no-open",
    "storybook:restart": "bash scripts/storybook-restart.sh",
    "storybook:check": "pnpm catalog:check && pnpm build-storybook && pnpm test:visual",
    "spec:build": "mdbook build ./spec",
    "spec:check": "pnpm spec:lint && pnpm spec:validate && pnpm spec:build && pnpm spec:test && pnpm spec:first",
    "spec:first": "node ./scripts/check-spec-first.mjs",
    "spec:lint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc",
    "spec:serve": "mdbook serve ./spec --open",
    "spec:test": "node --test ./scripts/check-spec-*.spec.mjs",
    "spec:validate": "node ./scripts/check-spec-structure.mjs && node ./scripts/check-spec-storybook.mjs",
    "test": "turbo run test",
    "test:e2e": "playwright test -c playwright.storybook.config.ts",
    "test:storybook": "vitest run --project storybook",
    "test:visual": "visual-delta test --affected --baseline-path-mode nested-import",
    "test:visual:affected": "visual-delta test --affected --baseline-path-mode nested-import",
    "test:visual:update": "visual-delta update --baseline-path-mode nested-import",
    "visual-delta": "visual-delta",
    "test:visual:report": "playwright show-report"
  },
  "dependencies": {
    "@lapismd/mira": "workspace:*",
    "@lapismd/mira-editor": "workspace:*",
    "@lapismd/mira-plugin-ai": "workspace:*",
    "@lapismd/mira-plugin-mermaid": "workspace:*",
    "@lapismd/mira-react": "workspace:*",
    "@lapismd/mira-vanilla": "workspace:*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.2",
    "@lapismd/storybook-addon-visual-delta": "^0.0.6",
    "@lucide/svelte": "^0.525.0",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/icons": "^2.1.0",
    "@storybook/mcp": "0.8.0",
    "@storybook/svelte-vite": "^10.5.6",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.10.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.23.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "publint": "^0.3.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semver": "^7.8.5",
    "storybook": "^10.5.6",
    "storybook-addon-tag-badges": "^3.1.0",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.10"
  }
}
