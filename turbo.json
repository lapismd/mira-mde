{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CI", "MIRA_VALIDATION_WORKER"],
  "globalPassThroughEnv": [
    "MIRA_VALIDATION_RUNTIME",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:svelte": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
