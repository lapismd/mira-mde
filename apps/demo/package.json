{
  "name": "@mira-mde/demo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:types": "svelte-kit sync && tsc -p tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig tsconfig.json",
    "dev": "vite dev --host 127.0.0.1",
    "lint": "eslint src --ext .ts,.svelte",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/svelte": "^0.525.0",
    "@mira-mde/core": "workspace:*",
    "@mira-mde/default-ui": "workspace:*",
    "@mira-mde/extensions": "workspace:*",
    "@mira-mde/plugin-mermaid": "workspace:*",
    "@mira-mde/preview": "workspace:*",
    "@mira-mde/svelte": "workspace:*",
    "@mira-mde/theme-obsidian": "workspace:*",
    "@mira-mde/ui": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.46.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.0"
  }
}
