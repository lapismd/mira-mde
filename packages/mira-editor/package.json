{
  "name": "@lapismd/mira-editor",
  "version": "0.0.1",
  "description": "Batteries-included Svelte Markdown editor, toolbar, features, and default styling for Mira.",
  "author": "Steve Juma <help@lapis.md>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/mira.git",
    "directory": "packages/mira-editor"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist && publint",
    "check": "pnpm check:format && pnpm check:svelte && pnpm check:types",
    "check:format": "prettier --ignore-path ../../.prettierignore . --check",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/svelte": "^0.525.0",
    "@lapismd/mira": "workspace:*",
    "@lapismd/mira-plugin-mermaid": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.46.1",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
