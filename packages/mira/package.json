{
  "name": "@lapismd/mira",
  "version": "0.0.1",
  "description": "Composable Markdown editor, extension SDK, preview renderer, and UI for Mira.",
  "author": "Steve Juma <help@lapis.md>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/mira.git",
    "directory": "packages/mira"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./codemirror": {
      "types": "./dist/codemirror.d.ts",
      "import": "./dist/codemirror.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "svelte": "./dist/preview/index.js",
      "import": "./dist/preview/index.js"
    },
    "./tables": {
      "types": "./dist/tables/index.d.ts",
      "svelte": "./dist/tables/index.js",
      "import": "./dist/tables/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "svelte": "./dist/ui/index.js",
      "import": "./dist/ui/index.js"
    },
    "./ui/table-dnd/sensors": {
      "types": "./dist/ui/table-dnd/table-dnd-sensors.d.ts",
      "import": "./dist/ui/table-dnd/table-dnd-sensors.js"
    },
    "./ui/table-dnd/utils": {
      "types": "./dist/ui/table-dnd/table-dnd-utils.d.ts",
      "import": "./dist/ui/table-dnd/table-dnd-utils.js"
    },
    "./ui/styles.css": "./dist/ui/styles.css",
    "./preview/styles.css": "./dist/preview/styles.css",
    "./ui/*": {
      "types": "./dist/ui/*/index.d.ts",
      "svelte": "./dist/ui/*/index.js",
      "import": "./dist/ui/*/index.js"
    },
    "./themes/obsidian.css": "./dist/themes/obsidian.css",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist && publint",
    "check": "pnpm check:format && pnpm check:svelte && pnpm check:types",
    "check:format": "prettier --ignore-path ../../.prettierignore . --check",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "lint": "eslint src --ext .ts,.svelte",
    "test": "vitest run"
  },
  "dependencies": {
    "@adobe/mdast-util-gridtables": "^4.0.13",
    "@adobe/remark-gridtables": "^3.0.14",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@fontsource/source-code-pro": "^5.2.7",
    "@lucide/svelte": "^0.525.0",
    "bits-ui": "2.18.1",
    "clsx": "^2.1.1",
    "hast-util-to-text": "^4.0.2",
    "lodash-es": "^4.17.21",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^1.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.4.3",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.4.3",
    "@types/hast": "^3.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "katex": "^0.16.22",
    "svelte": "^5.46.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
