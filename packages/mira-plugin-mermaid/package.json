{
  "name": "@lapismd/mira-plugin-mermaid",
  "version": "0.0.1",
  "description": "Mermaid language, preview, and diagram controls for Mira.",
  "author": "Steve Juma <help@lapis.md>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/mira.git",
    "directory": "packages/mira-plugin-mermaid"
  },
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package --input src --output dist && publint",
    "check": "pnpm check:format && pnpm check:svelte && pnpm check:types",
    "check:format": "prettier --ignore-path ../../.prettierignore . --check",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "lint": "eslint src --ext .ts,.svelte",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/svelte": "^0.525.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "@lapismd/mira": "workspace:*",
    "codemirror-lang-mermaid": "^0.5.0",
    "mermaid": "^11.12.1",
    "svg-pan-zoom": "^3.6.2",
    "svg2roughjs": "^3.2.1",
    "type-fest": "^4.41.0",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.11.3",
    "svelte": "^5.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@codemirror/language": "^6.11.3",
    "@types/hast": "^3.0.4",
    "svelte": "^5.46.1",
    "unified": "^11.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
