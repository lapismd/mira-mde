{
  "name": "@mira-mde/ui",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "svelte": "./dist/button/index.js",
      "import": "./dist/button/index.js"
    },
    "./separator": {
      "types": "./dist/separator/index.d.ts",
      "svelte": "./dist/separator/index.js",
      "import": "./dist/separator/index.js"
    },
    "./toggle-group": {
      "types": "./dist/toggle-group/index.d.ts",
      "svelte": "./dist/toggle-group/index.js",
      "import": "./dist/toggle-group/index.js"
    },
    "./scroll-area": {
      "types": "./dist/scroll-area/index.d.ts",
      "svelte": "./dist/scroll-area/index.js",
      "import": "./dist/scroll-area/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist && publint",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig tsconfig.json",
    "lint": "eslint src --ext .ts,.svelte",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "svelte": "^5.46.1",
    "tailwind-merge": "^3.4.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  }
}
