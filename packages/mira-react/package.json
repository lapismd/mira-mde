{
  "name": "@lapismd/mira-react",
  "version": "0.0.1",
  "description": "React adapters for the composable Mira and batteries-included Mira Editor surfaces.",
  "author": "Steve Juma <help@lapis.md>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/mira.git",
    "directory": "packages/mira-react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && cp src/styles.css dist/styles.css && publint",
    "check": "pnpm check:format && pnpm check:svelte && pnpm check:types",
    "check:format": "prettier --ignore-path ../../.prettierignore . --check",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:svelte": "echo \"no svelte files\"",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@lapismd/mira": "workspace:~",
    "@lapismd/mira-editor": "workspace:~",
    "@lapismd/mira-plugin-mermaid": "workspace:~",
    "lucide-react": "^0.525.0"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.5.2",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.46.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
