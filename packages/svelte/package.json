{
  "name": "@mira-mde/svelte",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist && publint",
    "check": "pnpm check:format && pnpm check:svelte && pnpm check:types",
    "check:format": "prettier --ignore-path ../../.prettierignore . --check",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "lint": "eslint src --ext .ts,.svelte",
    "test": "vitest run"
  },
  "dependencies": {
    "@mira-mde/codemirror": "workspace:*",
    "@mira-mde/codemirror-markdown": "workspace:*",
    "@mira-mde/codemirror-rich": "workspace:*",
    "@mira-mde/codemirror-tables": "workspace:*",
    "@mira-mde/core": "workspace:*",
    "@mira-mde/extensions": "workspace:*",
    "@mira-mde/preview": "workspace:*",
    "@mira-mde/ui": "workspace:*"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "svelte": "^5.46.1"
  }
}
