{
  "storybook:check": "pnpm catalog:check && pnpm build-storybook && pnpm test:e2e",
  "build": "turbo run build",
  "build-storybook": "pnpm build && node -e \"require('node:fs').mkdirSync('.visual-delta/cache',{recursive:true})\" && NODE_OPTIONS=--max-old-space-size=4096 storybook build --stats-json .visual-delta/cache",
  "catalog:check": "node ./scripts/check-catalog.mjs && node --test ./scripts/check-catalog.spec.mjs",
  "audit": "pnpm audit",
  "check": "pnpm audit && pnpm check:format && turbo run check",
  "check:all": "pnpm validation:check && pnpm check && pnpm lint && pnpm test && pnpm build",
  "check:format": "prettier . --check",
  "check:svelte": "turbo run check:svelte",
  "check:types": "turbo run check:types",
  "lint": "eslint .",
  "packages:check": "node ./scripts/check-package-boundaries.mjs && node --test ./scripts/check-package-boundaries.spec.mjs && pnpm release:check && pnpm release:test",
  "packages:pack": "pnpm build && node --test ./scripts/build-math-adapters.spec.mjs ./scripts/math-compile-diagnostics.spec.mjs && node ./scripts/check-package-tarballs.mjs",
  "release:check": "node ./scripts/check-release-config.mjs && node ./scripts/check-release-workflow.mjs && node ./scripts/sync-release-versions.mjs --check",
  "release:test": "node --test ./scripts/check-release-changesets.spec.mjs ./scripts/check-release-intent.spec.mjs ./scripts/check-release-source.spec.mjs ./scripts/check-release-recovery.spec.mjs ./scripts/check-release-workflow.spec.mjs ./scripts/create-github-releases.spec.mjs ./scripts/packed-audit-policy.spec.mjs ./scripts/publish-release.spec.mjs ./scripts/release-manifest.spec.mjs ./scripts/release-plan.spec.mjs ./scripts/sync-release-versions.spec.mjs ./scripts/verify-npm-provenance.spec.mjs ./scripts/verify-release.spec.mjs",
  "spec:build": "node scripts/dependency-automation/spec-policy.mjs build",
  "spec:check": "node scripts/dependency-automation/spec-policy.mjs check",
  "spec:first": "node scripts/dependency-automation/spec-policy.mjs first",
  "spec:lint": "node scripts/dependency-automation/spec-policy.mjs --command spec:lint 'markdownlint --config .markdownlint.json AGENTS.md README.md '\\''packages/*/README.md'\\'' '\\''spec/src/**/*.md'\\'''",
  "spec:validate": "node scripts/dependency-automation/spec-policy.mjs validate && pnpm spec:lint",
  "test": "turbo run test",
  "test:e2e": "playwright test -c playwright.storybook.config.ts",
  "test:storybook": "vitest run --project storybook",
  "validation:check": "node --test scripts/validation.test.mjs",
  "validation:smoke": "node scripts/validation/smoke.mjs"
}
